# here take precedence. The access token is a secret and is best kept in env.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_OWNER="201157447575"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_COUNTRY_CODE="20"
# Set to 1 to log sends without calling Meta (useful for local testing).
WHATSAPP_DRY_RUN=""
