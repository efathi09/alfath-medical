# Vite build-time environment variables.
# Copy to `.env` / `.env.local` (git-ignored) or set inline, e.g.:
#   VITE_API_BASE=https://YOUR-PROJECT.pages.dev npm run cap:build
#
# NOTE: `alfath-medical.pages.dev` / `alfath.pages.dev` are NOT live — use the
# exact domain your project is deployed to (Cloudflare Pages → your project).

# Base URL of the deployed API. Leave empty for the web build (same-origin `/api`).
# Required for the native (Capacitor) app because it loads the bundled site from
# `capacitor://localhost` and must reach the deployed API instead.
#
# Use `npm run cap:build` (NOT bare `cap:sync`) for native builds: it refuses to
# build when this is empty, so you never ship an app that can't load its data.
VITE_API_BASE=
