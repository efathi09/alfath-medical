{
  "name": "medical-empire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arabic RTL e-commerce storefront for medical supplies",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "gen:seed": "node scripts/gen-seed.mjs",
    "products:template": "node scripts/make-product-template.mjs",
    "products:check": "node scripts/validate-products-csv.mjs",
    "products:from-xlsx": "node scripts/xlsx-to-products-csv.mjs",
    "seed": "node scripts/seed-neon.mjs",
    "seed:reset": "node scripts/seed-neon.mjs --reset",
    "db:migrate": "node scripts/migrate.mjs",
    "pages:build": "wrangler pages functions build --outdir=.wrangler/functions-build",
    "deploy": "vite build && wrangler pages deploy dist --project-name alfath-medical",
    "cap:sync": "vite build && cap sync",
    "cap:build": "node scripts/build-native.mjs",
    "cap:build:android": "node scripts/build-native.mjs --apk",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "android:apk": "cd android && .\\gradlew.bat -g C:/Users/Ehab/.gradle --no-daemon assembleDebug",
    "assets:gen": "node scripts/gen-app-assets.mjs",
    "assets:icons": "node scripts/gen-android-icon.mjs",
    "assets:splash": "node scripts/gen-android-splash.mjs",
    "assets:fonts": "node scripts/vendor-fonts.mjs",
    "cap:assets": "npm run assets:gen && capacitor-assets generate --android --ios --iconBackgroundColor #ffffff --iconBackgroundColorDark #12536b --splashBackgroundColor #ffffff --splashBackgroundColorDark #12536b --logoSplashScale 0.3 && npm run assets:icons && npm run assets:splash"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "exceljs": "^4.4.0",
    "globals": "^16.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.151.1"
  }
}
